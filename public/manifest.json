{
  "short_name": "Warholizer",
  "name": "Warholizer",
  "description": "Turn photos into print-ready art for collage.",
  "id": "/composer",
  "start_url": "/composer",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#111318",
  "background_color": "#f4f4f6",
  "icons": [
    { "src": "/logo192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/logo512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/logo512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/composer/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "photos", "accept": ["image/*"] }]
    }
  }
}
