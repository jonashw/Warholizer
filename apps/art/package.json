{
  "name": "art-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The art knowledge base at art.jonashw.dev: a Cloudflare Worker serving pages from D1 and images from R2.",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/build-seed.mjs",
    "snapshot": "tsx scripts/snapshot.ts",
    "db:migrate:local": "wrangler d1 migrations apply kb --local",
    "db:seed:local": "wrangler d1 execute kb --local --file seed/seed.sql",
    "db:migrate": "wrangler d1 migrations apply kb --remote",
    "db:seed": "wrangler d1 execute kb --remote --file seed/seed.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  }
}
